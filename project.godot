; APEX REBOOT — open this file with Godot 4.6.3.
config_version=5

[application]
config/name="APEX REBOOT"
config/description="Circuitos en tres dimensiones. Cuatro formas de conducir."
config/version="0.3.2"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/resizable=true
window/size/min_width=960
window/size/min_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
environment/defaults/default_clear_color=Color(0.035, 0.047, 0.067, 1)
occlusion_culling/use_occlusion_culling=true

[physics]
common/physics_ticks_per_second=120
common/physics_interpolation=true
3d/default_gravity=9.81
3d/default_linear_damp=0.0
3d/default_angular_damp=0.0
3d/physics_engine="GodotPhysics3D"

[audio]
driver/enable_input=false

[debug]
gdscript/warnings/untyped_declaration=0
